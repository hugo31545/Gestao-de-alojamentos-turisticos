<UserControl x:Class="POOfase1trabalho13_11.Views.AuditoriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:POOfase1trabalho13_11.Views"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">

    <Grid Background="#F5F5F5">
        <DockPanel Margin="10">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Pesquisar (Entidade, Operação ou User): " VerticalAlignment="Center" FontWeight="SemiBold"/>

                <TextBox Width="200" 
                         Text="{Binding FiltroGeral, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="10,0" 
                         VerticalContentAlignment="Center"
                         Padding="5,2"/>

                <Button Content="🔄 Atualizar Lista" 
                        Command="{Binding AtualizarCommand}" 
                        Padding="15,5" 
                        Background="#E1E1E1"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding ListaLogs}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      SelectionMode="Single"
                      SelectedItem="{Binding RegistoSelecionado}"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#DDDDDD"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      BorderBrush="#CCCCCC"
                      BorderThickness="1">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Data / Hora" 
                                        Binding="{Binding DataRegisto, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" 
                                        Width="150"/>

                    <DataGridTextColumn Header="Operação" 
                                        Binding="{Binding Operacao}" 
                                        Width="100"/>

                    <DataGridTextColumn Header="Entidade" 
                                        Binding="{Binding TipoEntidade}" 
                                        Width="120"/>

                    <DataGridTextColumn Header="Descrição dos Detalhes" 
                                        Binding="{Binding Detalhes}" 
                                        Width="*"/>

                    <DataGridTextColumn Header="Efetuado por" 
                                        Binding="{Binding Utilizador}" 
                                        Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>