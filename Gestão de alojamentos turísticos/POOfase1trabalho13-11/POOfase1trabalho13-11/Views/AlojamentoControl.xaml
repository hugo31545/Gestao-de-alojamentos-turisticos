<UserControl x:Class="POOfase1trabalho13_11.Views.AlojamentoControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:enums="clr-namespace:POOfase1trabalho13_11.Models.Enums"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="950" Background="White">

    <UserControl.Resources>
        <ObjectDataProvider x:Key="EstadosEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:EstadoAlojamento"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Gestão de Alojamentos" FontSize="20" FontWeight="Bold"  Foreground="#2C3E50"/>

        <GroupBox Header="Registar / Modificar Alojamento" Grid.Row="1" Padding="10" Margin="0,0,0,15">
            <StackPanel>
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                    <StackPanel Margin="5">
                        <TextBlock Text="Nome:"/>
                        <TextBox Width="140" Text="{Binding AlojamentoEmEdicao.Nome, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Localização:"/>
                        <TextBox Width="140" Text="{Binding AlojamentoEmEdicao.Localizacao, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Preço/Noite (€):"/>
                        <TextBox Width="80" 
             Text="{Binding AlojamentoEmEdicao.PrecoPorNoite, 
                    UpdateSourceTrigger=PropertyChanged, 
                    TargetNullValue='', 
                    ValidatesOnExceptions=True, 
                    StringFormat={}{0:N2}}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Capacidade:"/>
                        <TextBox Width="70" 
             Text="{Binding AlojamentoEmEdicao.Capacidade, 
                    UpdateSourceTrigger=PropertyChanged, 
                    TargetNullValue='', 
                    ValidatesOnExceptions=True}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Estado Atual:"/>
                        <ComboBox Width="130" 
                          ItemsSource="{Binding Source={StaticResource EstadosEnum}}"
                          SelectedItem="{Binding AlojamentoEmEdicao.Estado}"/>
                    </StackPanel>
                </WrapPanel>

                <StackPanel Margin="5">
                    <TextBlock Text="Descrição:"/>
                    <TextBox Height="40" TextWrapping="Wrap" AcceptsReturn="True" 
                     Text="{Binding AlojamentoEmEdicao.Descricao, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,5,0">
                    <Button Content="Gravar Alterações" Command="{Binding AdicionarAlojamentoCommand}"
                    Width="140" Height="30" Margin="5,0" Background="#27AE60" Foreground="White" FontWeight="Bold"/>

                    <Button Content="Novo / Limpar" Command="{Binding NovoCommand}"
                    Width="100" Height="30" Margin="5,0" Background="#3498DB" Foreground="White"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <DataGrid Grid.Row="2" 
          AutoGenerateColumns="False" 
          IsReadOnly="True"
          ItemsSource="{Binding ListaAlojamentos, Mode=OneWay}"
          SelectedItem="{Binding AlojamentoSelecionado, Mode=TwoWay}"
          SelectionMode="Single"
          VirtualizingStackPanel.IsVirtualizing="True"
          EnableRowVirtualization="True"
          AlternatingRowBackground="#F9F9F9">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="180"/>
                <DataGridTextColumn Header="Localização" Binding="{Binding Localizacao}" Width="150"/>
                <DataGridTextColumn Header="Preço" Binding="{Binding PrecoPorNoite, StringFormat={}{0:N2}€}" Width="90"/>
                <DataGridTextColumn Header="Cap." Binding="{Binding Capacidade}" Width="50"/>

                <DataGridTemplateColumn Header="Estado" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Estado}" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="{Binding MensagemStatus}" FontStyle="Italic" Foreground="Gray" Margin="0,5,0,0"/>
    </Grid>
</UserControl>