<UserControl x:Class="POOfase1trabalho13_11.Views.Controls.FormField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">

    <UserControl.Resources>
        <Style x:Key="EstiloEntrada" TargetType="Control">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#BDC3C7"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError, ElementName=Root}" Value="True">
                    <Setter Property="BorderBrush" Value="#C0392B"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Label, ElementName=Root}" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,3"/>

        <Grid>
            <TextBox x:Name="EntradaTexto" Text="{Binding Text, ElementName=Root, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.Style>
                    <Style TargetType="TextBox" BasedOn="{StaticResource EstiloEntrada}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPassword, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBox.Style>
            </TextBox>

            <PasswordBox x:Name="EntradaPassword" PasswordChanged="EntradaPassword_PasswordChanged">
                <PasswordBox.Style>
                    <Style TargetType="PasswordBox" BasedOn="{StaticResource EstiloEntrada}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPassword, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </PasswordBox.Style>
            </PasswordBox>

            <TextBlock Text="{Binding Placeholder, ElementName=Root}"
                       IsHitTestVisible="False"
                       Foreground="#95A5A6"
                       VerticalAlignment="Center"
                       Margin="9,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <TextBlock Text="{Binding Error, ElementName=Root}"
                   Foreground="#C0392B"
                   FontSize="11.5"
                   TextWrapping="Wrap"
                   Margin="0,3,0,0">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasError, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </StackPanel>
</UserControl>
