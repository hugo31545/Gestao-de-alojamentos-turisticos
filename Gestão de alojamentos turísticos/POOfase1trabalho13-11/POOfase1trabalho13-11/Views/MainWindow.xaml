<Window x:Class="POOfase1trabalho13_11.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:POOfase1trabalho13_11.ViewModels"
        Title="Gestão de Alojamentos" Height="500" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#EEEEEE">
            <Label Content="MENU" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <Label Content="Utilizador:"/>
            <TextBlock Text="{Binding UsernameLogado}" FontWeight="SemiBold" Margin="5,0,0,15"/>

            <Button Content="Alojamentos" Command="{Binding ShowAlojamentosCommand}" Margin="0,5"/>
            <Button Content="Clientes" Command="{Binding ShowClientesCommand}" Margin="0,5"/>
            <Button Content="Reservas" Command="{Binding ShowReservasCommand}" Margin="0,5"/>
            <Button Content="Auditoria" Command="{Binding ShowAuditoriaCommand}" Margin="0,5"/>
            

            <Separator Margin="0,20"/>

            <Button Content="Sair" Command="{Binding LogoutCommand}" Background="LightCoral"/>
        </StackPanel>

        <Border Grid.Column="1" Padding="20">
            <ContentControl Content="{Binding CurrentView}" />
        </Border>
    </Grid>
</Window>