<UserControl x:Class="POOfase1trabalho13_11.Views.RegistryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="400">

    <Grid Background="#F5F5F5">
        <Border VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                Background="White" 
                Width="350" 
                Padding="25"
                CornerRadius="12">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.1" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Registar Funcionário" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,20"/>

                <Label Content="Nome Completo" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Label Content="Email" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Label Content="NIF" FontWeight="SemiBold"/>
                <TextBox Text="{Binding NIF, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>
                <Label Content="Password" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                        Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                <Label Content="Confirmar Password" FontWeight="SemiBold"/>
                <TextBox Text="{Binding PasswordConfirmacao, UpdateSourceTrigger=PropertyChanged}" 
                        Height="30" VerticalContentAlignment="Center" Margin="0,0,0,20"/>
                
                <Label Content="Cargo" FontWeight="SemiBold"/>
                <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}" 
                         Height="30" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                <Button Content="Finalizar Registo" 
                        Command="{Binding RegistarCommand}" 
                        Height="40"
                        Background="#27AE60" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <TextBlock Text="{Binding MensagemFeedback}" 
                           Foreground="#E74C3C" 
                           HorizontalAlignment="Center" 
                           Margin="0,15,0,0" 
                           TextWrapping="Wrap"
                           FontWeight="Medium"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>