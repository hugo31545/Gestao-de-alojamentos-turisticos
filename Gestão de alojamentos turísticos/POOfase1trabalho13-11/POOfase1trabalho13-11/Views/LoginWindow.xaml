<Window x:Class="POOfase1trabalho13_11.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:POOfase1trabalho13_11.Views.Controls"
        Title="Gestão de Alojamentos - Iniciar sessão"
        Height="470"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Grid>
        <Border Background="White"
                Width="330"
                Padding="28"
                CornerRadius="12"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Opacity="0.12" ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Gestão de Alojamentos"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="#2C3E50"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Inicie sessão para continuar"
                           Foreground="#7F8C8D"
                           HorizontalAlignment="Center"
                           Margin="0,4,0,22"/>

                <controls:FormField x:Name="CampoEmail" Label="Email"
                                    Placeholder="nome@dominio.pt"
                                    Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Margin="0,0,0,12"/>

                <controls:FormField Label="Password"
                                    Placeholder="A sua password"
                                    IsPassword="True"
                                    Text="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Mensagem de erro do login (ex.: credenciais incorretas) -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="#C0392B"
                           TextWrapping="Wrap"
                           MinHeight="36"
                           Margin="0,10,0,4"
                           VerticalAlignment="Center"/>

                <Button Content="Entrar"
                        Style="{StaticResource BotaoPrimario}"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding Username}"
                        IsDefault="True"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="Ainda não tem conta?" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                    <Button Command="{Binding RegistryCommand}"
                            Style="{StaticResource BotaoLink}"
                            Margin="6,0,0,0">
                        <TextBlock Text="Criar conta" Foreground="#2980B9" FontWeight="SemiBold" TextDecorations="Underline"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
