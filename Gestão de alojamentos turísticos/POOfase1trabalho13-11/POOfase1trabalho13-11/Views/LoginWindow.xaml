<Window x:Class="POOfase1trabalho13_11.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:POOfase1trabalho13_11.Views"
        xmlns:helpers="clr-namespace:POOfase1trabalho13_11.Views.Helpers"
        mc:Ignorable="d"
        Title="Login - Sistema de Gestão"
        Height="350"
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Background="#F0F0F0">

        <Border Background="Beige"
                Width="280"
                Padding="20"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  Opacity="0.2"
                                  ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel>

                <Label Content="Email"
                       FontWeight="Bold"
                       Margin="0,0,0,2"/>

                <TextBox Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,12"
                         Height="25"
                         VerticalContentAlignment="Center"/>

                <Label Content="Password"
                       FontWeight="Bold"
                       Margin="0,0,0,2"/>

                <PasswordBox helpers:PasswordBoxHelper.BoundPassword="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20"
                             Height="25"
                             VerticalContentAlignment="Center"/>

                <Button Content="Entrar"
                        Command="{Binding LoginCommand}"
                        CommandParameter="{Binding Username}"
                        Height="35"
                        Margin="0,0,0,10"
                        Background="#2C3E50"
                        Foreground="White"
                        FontWeight="Bold"/>

                <Button Content="Criar Conta (Registry)"
                        Command="{Binding RegistryCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Blue"
                        Cursor="Hand"
                        FontSize="11"/>
                
            </StackPanel>
        </Border>

    </Grid>
</Window>
