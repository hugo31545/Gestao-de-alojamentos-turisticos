<UserControl x:Class="POOfase1trabalho13_11.Views.ReservasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             Background="#F5F6FA">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Sistema de Reservas" FontSize="26" FontWeight="ExtraBold" Foreground="#2C3E50"/>
            <Separator Margin="0,10" Background="#DCDDE1"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="8" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Direction="-90" RenderingBias="Quality" ShadowDepth="2" Opacity="0.1"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="Criar Nova Reserva" FontWeight="Bold" Margin="0,0,0,10" Foreground="#34495E"/>
                <UniformGrid Columns="4">
                    <StackPanel Margin="5">
                        <TextBlock Text="Cliente:"/>
                        <ComboBox ItemsSource="{Binding ListaClientes}" 
                                  SelectedItem="{Binding ClienteSelecionado}"
                                  DisplayMemberPath="Nome" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Check-In:"/>
                        <DatePicker SelectedDate="{Binding DataInicio, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Check-Out:"/>
                        <DatePicker SelectedDate="{Binding DataFim, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Alojamento Disponível:"/>
                        <ComboBox ItemsSource="{Binding ListaAlojamentosDisponiveis}" 
                                  SelectedItem="{Binding AlojamentoSelecionado}"
                                  DisplayMemberPath="Nome" Padding="5"/>
                    </StackPanel>

                    <StackPanel Margin="5">
                        <TextBlock Text="Nº Hóspedes:"/>
                        <TextBox Text="{Binding NumHospedes, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>

                    <Button Content="Confirmar Reserva" 
                            Command="{Binding CriarReservaCommand}"
                            Background="#27AE60" Foreground="White" FontWeight="Bold" 
                            Margin="5,15,5,0" Height="35">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" 
                  ItemsSource="{Binding ListaReservas}" 
                  SelectedItem="{Binding ReservaSelecionada}"
                  AutoGenerateColumns="False" 
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Background="White"
                  BorderThickness="0"
                  RowHeight="45">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Check-In" Binding="{Binding DataCheckIn, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Check-Out" Binding="{Binding DataCheckOut, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                <DataGridTextColumn Header="Hóspedes" Binding="{Binding NumeroHospedes}" Width="80"/>

                <DataGridTextColumn Header="Motivo / Obs" Binding="{Binding Observacoes}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter Property="Foreground" Value="#7F8C8D"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="Estado" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" 
                                    Background="#DFF9FB" 
                                    ToolTip="{Binding Observacoes}">
                                <TextBlock Text="{Binding Estado}" Foreground="#130F40" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Ações" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Check-In" 
                                        Command="{Binding DataContext.CheckInCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#2980B9" Foreground="White" Padding="8,2" Margin="2,0" FontSize="10" FontWeight="SemiBold"/>

                                <Button Content="Check-Out" 
                                        Command="{Binding DataContext.CheckOutCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#8E44AD" Foreground="White" Padding="8,2" Margin="2,0" FontSize="10" FontWeight="SemiBold"/>

                                <Button Content="Cancelar" 
                                        Command="{Binding DataContext.CancelarReservaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Background="#E74C3C" Foreground="White" Padding="8,2" Margin="2,0" FontSize="10" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#2C3E50" Padding="15" Margin="0,10,0,0" CornerRadius="5">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="Motivo Cancelamento: " Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox Width="350" Text="{Binding MotivoCancelamento, UpdateSourceTrigger=PropertyChanged}" Margin="10,0" VerticalContentAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ListaReservas.Count, StringFormat='Total: {0} Reservas'}" 
                           Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>