<Application x:Class="POOfase1trabalho13_11.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:POOfase1trabalho13_11"
             xmlns:vm="clr-namespace:POOfase1trabalho13_11.ViewModels"
             xmlns:v="clr-namespace:POOfase1trabalho13_11.Views">

    <Application.Resources>
        <ResourceDictionary>

            <!-- Botão principal: cor própria, cinzento quando desativado (o estilo padrão ignora o Background) -->
            <Style x:Key="BotaoPrimario" TargetType="Button">
                <Setter Property="Background" Value="#2C3E50"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Fundo" Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Fundo" Property="Opacity" Value="0.88"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Fundo" Property="Background" Value="#BDC3C7"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botão com aspeto de ligação (texto sublinhado, sem fundo) -->
            <Style x:Key="BotaoLink" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate DataType="{x:Type vm:AlojamentoViewModel}">
                <v:AlojamentoControl />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ClienteViewModel}">
                <v:ClienteView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ReservaViewModel}">
                <v:ReservasView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RegistryViewModel}">
                <v:RegistryView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AuditoriaViewModel}">
                <v:AuditoriaView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RelatoriosViewModel}">
                <v:RelatoriosView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>